<?xml version="1.0"?>
<sdf version="1.9">
  <model name="avaj_car">
    <!-- Maße in Meter: Radstand 0.270, Spurweite 0.245, Reifen 0.080 x 0.036. -->
    <pose>0 -5 0.041 0 0 0</pose>

    <link name="base_link">
      <pose>0 0 0.055 0 0 0</pose>
      <inertial>
        <!-- Vorläufiger Startwert, bis das reale Fahrzeug gewogen wurde. -->
        <mass>3.0</mass>
        <inertia>
          <ixx>0.009925</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.033300</iyy><iyz>0</iyz><izz>0.041325</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry><box><size>0.36 0.19 0.06</size></box></geometry>
      </collision>
      <visual name="visual">
        <geometry><box><size>0.36 0.19 0.06</size></box></geometry>
        <material><ambient>0.04 0.18 0.65 1</ambient><diffuse>0.06 0.30 0.95 1</diffuse></material>
      </visual>
    </link>

    <!-- Kamera: Fahrzeugfront, 6 cm über dem Boden, Blick geradeaus (+X). -->
    <link name="camera_link">
      <pose>0.18 0 0.019 0 0 0</pose>
      <inertial><mass>0.03</mass><inertia><ixx>0.000005</ixx><iyy>0.000005</iyy><izz>0.000005</izz></inertia></inertial>
      <visual name="visual"><geometry><box><size>0.025 0.035 0.025</size></box></geometry><material><diffuse>0.1 0.1 0.1 1</diffuse></material></visual>
      <sensor name="uc852_sim" type="camera">
        <always_on>true</always_on><update_rate>20</update_rate><topic>/sim/camera/image_raw</topic>
        <camera>
          <camera_info_topic>/sim/camera/camera_info</camera_info_topic>
          <horizontal_fov>1.5708</horizontal_fov>
          <image><width>640</width><height>360</height><format>R8G8B8</format></image>
          <clip><near>0.05</near><far>30.0</far></clip>
        </camera>
      </sensor>
    </link>
    <joint name="camera_fixed_joint" type="fixed"><parent>base_link</parent><child>camera_link</child></joint>

    <!-- STL27: Fahrzeugfront, 10 cm über Boden, Nullrichtung 90 Grad rechts. -->
    <link name="lidar_link">
      <pose>0.18 0 0.059 0 0 -1.57079632679</pose>
      <inertial><mass>0.05</mass><inertia><ixx>0.00001</ixx><iyy>0.00001</iyy><izz>0.00001</izz></inertia></inertial>
      <visual name="visual"><geometry><cylinder><radius>0.025</radius><length>0.035</length></cylinder></geometry><material><diffuse>0.12 0.12 0.12 1</diffuse></material></visual>
      <sensor name="stl27_sim" type="gpu_lidar">
        <always_on>true</always_on><update_rate>10</update_rate><topic>lidar</topic>
        <ray>
          <scan><horizontal><samples>720</samples><resolution>1</resolution><min_angle>-3.14159265</min_angle><max_angle>3.14159265</max_angle></horizontal></scan>
          <range><min>0.02</min><max>25.0</max><resolution>0.01</resolution></range>
        </ray>
      </sensor>
    </link>
    <joint name="lidar_fixed_joint" type="fixed"><parent>base_link</parent><child>lidar_link</child></joint>

    <!-- BNO085: Fahrzeugmitte, aufrecht montiert. -->
    <link name="imu_link">
      <pose>0 0 0.055 0 0 0</pose>
      <inertial><mass>0.01</mass><inertia><ixx>0.000001</ixx><iyy>0.000001</iyy><izz>0.000001</izz></inertia></inertial>
      <visual name="visual"><geometry><box><size>0.025 0.025 0.008</size></box></geometry><material><diffuse>0.1 0.55 0.1 1</diffuse></material></visual>
      <sensor name="bno085_sim" type="imu">
        <always_on>true</always_on><update_rate>100</update_rate><topic>/sim/imu/data</topic>
      </sensor>
    </link>
    <joint name="imu_fixed_joint" type="fixed"><parent>base_link</parent><child>imu_link</child></joint>

    <link name="front_left_steering_link">
      <pose>0.135 0.1045 0 0 0 0</pose>
      <inertial><mass>0.05</mass><inertia><ixx>0.00001</ixx><iyy>0.00001</iyy><izz>0.00001</izz></inertia></inertial>
    </link>
    <link name="front_right_steering_link">
      <pose>0.135 -0.1045 0 0 0 0</pose>
      <inertial><mass>0.05</mass><inertia><ixx>0.00001</ixx><iyy>0.00001</iyy><izz>0.00001</izz></inertia></inertial>
    </link>

    <link name="front_left_wheel">
      <pose>0.135 0.1225 0 -1.57079632679 0 0</pose>
      <inertial><mass>0.12</mass><inertia><ixx>0.00006096</ixx><iyy>0.00006096</iyy><izz>0.000096</izz></inertia></inertial>
      <collision name="collision"><geometry><cylinder><radius>0.04</radius><length>0.036</length></cylinder></geometry><surface><friction><ode><mu>1.2</mu><mu2>0.7</mu2><fdir1>0 0 1</fdir1></ode></friction></surface></collision>
      <visual name="visual"><geometry><cylinder><radius>0.04</radius><length>0.036</length></cylinder></geometry><material><diffuse>0.025 0.025 0.025 1</diffuse></material></visual>
    </link>
    <link name="front_right_wheel">
      <pose>0.135 -0.1225 0 -1.57079632679 0 0</pose>
      <inertial><mass>0.12</mass><inertia><ixx>0.00006096</ixx><iyy>0.00006096</iyy><izz>0.000096</izz></inertia></inertial>
      <collision name="collision"><geometry><cylinder><radius>0.04</radius><length>0.036</length></cylinder></geometry><surface><friction><ode><mu>1.2</mu><mu2>0.7</mu2><fdir1>0 0 1</fdir1></ode></friction></surface></collision>
      <visual name="visual"><geometry><cylinder><radius>0.04</radius><length>0.036</length></cylinder></geometry><material><diffuse>0.025 0.025 0.025 1</diffuse></material></visual>
    </link>
    <link name="rear_left_wheel">
      <pose>-0.135 0.1225 0 -1.57079632679 0 0</pose>
      <inertial><mass>0.12</mass><inertia><ixx>0.00006096</ixx><iyy>0.00006096</iyy><izz>0.000096</izz></inertia></inertial>
      <collision name="collision"><geometry><cylinder><radius>0.04</radius><length>0.036</length></cylinder></geometry><surface><friction><ode><mu>1.2</mu><mu2>0.7</mu2><fdir1>0 0 1</fdir1></ode></friction></surface></collision>
      <visual name="visual"><geometry><cylinder><radius>0.04</radius><length>0.036</length></cylinder></geometry><material><diffuse>0.025 0.025 0.025 1</diffuse></material></visual>
    </link>
    <link name="rear_right_wheel">
      <pose>-0.135 -0.1225 0 -1.57079632679 0 0</pose>
      <inertial><mass>0.12</mass><inertia><ixx>0.00006096</ixx><iyy>0.00006096</iyy><izz>0.000096</izz></inertia></inertial>
      <collision name="collision"><geometry><cylinder><radius>0.04</radius><length>0.036</length></cylinder></geometry><surface><friction><ode><mu>1.2</mu><mu2>0.7</mu2><fdir1>0 0 1</fdir1></ode></friction></surface></collision>
      <visual name="visual"><geometry><cylinder><radius>0.04</radius><length>0.036</length></cylinder></geometry><material><diffuse>0.025 0.025 0.025 1</diffuse></material></visual>
    </link>

    <joint name="front_left_steering_joint" type="revolute">
      <parent>base_link</parent><child>front_left_steering_link</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-0.60</lower><upper>0.60</upper><effort>8</effort><velocity>3</velocity></limit></axis>
    </joint>
    <joint name="front_right_steering_joint" type="revolute">
      <parent>base_link</parent><child>front_right_steering_link</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-0.60</lower><upper>0.60</upper><effort>8</effort><velocity>3</velocity></limit></axis>
    </joint>
    <joint name="front_left_wheel_joint" type="revolute">
      <parent>front_left_steering_link</parent><child>front_left_wheel</child><axis><xyz>0 0 1</xyz></axis>
    </joint>
    <joint name="front_right_wheel_joint" type="revolute">
      <parent>front_right_steering_link</parent><child>front_right_wheel</child><axis><xyz>0 0 1</xyz></axis>
    </joint>
    <joint name="rear_left_wheel_joint" type="revolute">
      <parent>base_link</parent><child>rear_left_wheel</child><axis><xyz>0 0 1</xyz></axis>
    </joint>
    <joint name="rear_right_wheel_joint" type="revolute">
      <parent>base_link</parent><child>rear_right_wheel</child><axis><xyz>0 0 1</xyz></axis>
    </joint>

    <plugin filename="gz-sim-ackermann-steering-system" name="gz::sim::systems::AckermannSteering">
      <!-- Je zwei linke/rechte Antriebsgelenke ergeben Allradantrieb. -->
      <left_joint>front_left_wheel_joint</left_joint>
      <left_joint>rear_left_wheel_joint</left_joint>
      <right_joint>front_right_wheel_joint</right_joint>
      <right_joint>rear_right_wheel_joint</right_joint>
      <left_steering_joint>front_left_steering_joint</left_steering_joint>
      <right_steering_joint>front_right_steering_joint</right_steering_joint>
      <kingpin_width>0.209</kingpin_width>
      <wheel_base>0.270</wheel_base>
      <wheel_separation>0.245</wheel_separation>
      <wheel_radius>0.040</wheel_radius>
      <steering_limit>0.55</steering_limit>
      <min_velocity>-4.0</min_velocity><max_velocity>4.0</max_velocity>
      <min_acceleration>-5.0</min_acceleration><max_acceleration>5.0</max_acceleration>
      <odom_publish_frequency>50</odom_publish_frequency>
    </plugin>
  </model>
</sdf>
