<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="jetson_test_track">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.2 -1</direction>
    </light>

    <model name="ground">
      <static>true</static>
      <link name="ground_link">
        <collision name="collision">
          <geometry><box><size>30 20 0.1</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>30 20 0.1</size></box></geometry>
          <material><diffuse>0.12 0.12 0.12 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="north_wall">
      <static>true</static><pose>0 8 0.3 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>26 0.25 0.6</size></box></geometry></collision><visual name="visual"><geometry><box><size>26 0.25 0.6</size></box></geometry><material><diffuse>0.9 0.2 0.1 1</diffuse></material></visual></link>
    </model>
    <model name="south_wall">
      <static>true</static><pose>0 -8 0.3 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>26 0.25 0.6</size></box></geometry></collision><visual name="visual"><geometry><box><size>26 0.25 0.6</size></box></geometry><material><diffuse>0.9 0.2 0.1 1</diffuse></material></visual></link>
    </model>
    <model name="east_wall">
      <static>true</static><pose>13 0 0.3 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>0.25 16.25 0.6</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.25 16.25 0.6</size></box></geometry><material><diffuse>0.9 0.2 0.1 1</diffuse></material></visual></link>
    </model>
    <model name="west_wall">
      <static>true</static><pose>-13 0 0.3 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>0.25 16.25 0.6</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.25 16.25 0.6</size></box></geometry><material><diffuse>0.9 0.2 0.1 1</diffuse></material></visual></link>
    </model>

    <model name="center_island">
      <static>true</static><pose>0 0 0.2 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>11 5 0.4</size></box></geometry></collision><visual name="visual"><geometry><box><size>11 5 0.4</size></box></geometry><material><diffuse>0.15 0.45 0.15 1</diffuse></material></visual></link>
    </model>

    <include>
      <uri>file:///workspace/simulation/models/avaj_car</uri>
    </include>
  </world>
</sdf>
