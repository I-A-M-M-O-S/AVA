<targetDirectedRelationshipPropertyPath_>
<reflist>
<ref refid="d0aeec19-8d21-11f1-b4ad-fb02fba3bdca"/>
</reflist>
</targetDirectedRelationshipPropertyPath_>
<text>
<val>Im autonomen Zustand soll das RC-Auto selbst fahren.</val>
</text>
</SysML:Requirement>
<SysML:RequirementItem id="46494b2e-8d20-11f1-8339-fb02fba3bdca">
<matrix>
<val>(1.0, 0.0, 0.0, 1.0, 547.9783630371094, 436.3058166503906)</val>
