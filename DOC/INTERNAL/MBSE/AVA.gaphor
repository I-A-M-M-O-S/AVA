<ref refid="0470898d-9caa-11f1-a2b0-b16b4be29dfd"/>
</reflist>
</targetDirectedRelationshipPropertyPath_>
<text>
<val>Im Ruhezustand, manuellen, sowie autonomen Modus soll der Bediener über eine Weboberfläche Zugriff auf Modusauswahl und Sensorikansicht erhalten.</val>
</text>
</SysML:Requirement>
<SysML:RequirementItem id="ea0f6d06-8d20-11f1-a780-fb02fba3bdca">
<matrix>
<val>(1.0, 0.0, 0.0, 1.0, 847.4654541015625, 425.0057373046875)</val>
