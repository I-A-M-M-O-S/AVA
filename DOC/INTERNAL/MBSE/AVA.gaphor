<reflist>
<ref refid="cd0f4791-8d21-11f1-b97d-fb02fba3bdca"/>
</reflist>
</targetDirectedRelationshipPropertyPath_>
<text>
<val>Im Ruhezustand, manuellen, sowie autonomen Modus muss das RC-Auto dem Bediener die Möglichkeit geben, den Fahrzustand zu wählen.</val>
</text>
</SysML:Requirement>
<SysML:RequirementItem id="8d5e6e6c-8d1c-11f1-b768-fb02fba3bdca">
