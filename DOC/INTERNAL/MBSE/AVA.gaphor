</SysML:RequirementItem>
<SysML:Requirement id="ea0e4155-8d20-11f1-a6ea-fb02fba3bdca">
<externalId>
<val>4</val>
</externalId>
<name>
<val>Autonomer Fahrmodus</val>
</name>
<owningPackage>
<ref refid="012edaba-70f5-11ec-aabc-f47b099bf663"/>
</owningPackage>
<package>
<ref refid="012edaba-70f5-11ec-aabc-f47b099bf663"/>
</package>
