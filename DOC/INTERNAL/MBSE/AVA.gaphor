<ref refid="46480165-8d20-11f1-a897-fb02fba3bdca"/>
</subject>
</SysML:RequirementItem>
<SysML:Requirement id="46480165-8d20-11f1-a897-fb02fba3bdca">
<externalId>
<val>3</val>
</externalId>
<name>
<val>Modusauswahl</val>
</name>
<owningPackage>
<ref refid="012edaba-70f5-11ec-aabc-f47b099bf663"/>
</owningPackage>
<package>
<ref refid="012edaba-70f5-11ec-aabc-f47b099bf663"/>
</package>
<presentation>
<reflist>
<ref refid="46494b2e-8d20-11f1-8339-fb02fba3bdca"/>
<ref refid="6debdbf5-8d9d-11f1-a7f9-6d67865a1084"/>
</reflist>
</presentation>
<targetDirectedRelationshipPropertyPath_>
<reflist>
<ref refid="cd0f4791-8d21-11f1-b97d-fb02fba3bdca"/>
</reflist>
</targetDirectedRelationshipPropertyPath_>
<text>
<val>Im Ruhezustand, manuellen, sowie autonomen Modus muss das RC-Auto dem Bediener die Möglichkeit geben, den Fahrzustand zu wählen.</val>
