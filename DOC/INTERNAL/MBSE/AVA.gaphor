<SysML:Requirement id="b634b75a-8d25-11f1-9d39-fb02fba3bdca">
<externalId>
<val>6</val>
</externalId>
<name>
<val>Manuelles Steuergerät</val>
</name>
<owningPackage>
<ref refid="012edaba-70f5-11ec-aabc-f47b099bf663"/>
</owningPackage>
<package>
<ref refid="012edaba-70f5-11ec-aabc-f47b099bf663"/>
</package>
<presentation>
<reflist>
<ref refid="5ff0253b-8d9d-11f1-8da7-6d67865a1084"/>
</reflist>
</presentation>
<targetDirectedRelationshipPropertyPath_>
<reflist>
<ref refid="80c40d18-8d9d-11f1-a545-6d67865a1084"/>
</reflist>
</targetDirectedRelationshipPropertyPath_>
<text>
<val>Im manuellen Modus soll der Bediener das RC-Auto mit einem mobilen Steuergerät lenken.</val>
</text>
</SysML:Requirement>
<SysML:Requirement id="3c05da99-8d21-11f1-930a-fb02fba3bdca">
<externalId>
<val>5</val>
</externalId>
<name>
<val>Weboberfläche</val>
