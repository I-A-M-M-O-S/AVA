	(text_box "Notes\n---\n- U1, U2 are connected to Jetson Orin via USB\n	-> Power transmission, comms\n-ESP32-DevKit\n	-> weak pull-downs (47K) for GPIO4, GPIO2, GPIO13, GPIO12: external\n	pull-down better for noisy environments\n	-> all GPIOs capable of PWM\n	-> GPIO4 in RTC power domain -> can be used in low-power mode for\n	touch sensor, not using it"
		(exclude_from_sim no)
		(at 177.8 133.35 0)
		(size 106.68 33.02)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
