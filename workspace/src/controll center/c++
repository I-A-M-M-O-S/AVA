#include <algorithm>
#include <chrono>
#include <cmath>
#include <cstdint>
#include <iomanip>
#include <limits>
#include <memory>
#include <sstream>
#include <string>

#include "nav_msgs/msg/odometry.hpp"
#include "rc_car_interfaces/msg/drive_request.hpp"
#include "rclcpp/rclcpp.hpp"
#include "sensor_msgs/msg/imu.hpp"
#include "sensor_msgs/msg/laser_scan.hpp"
#include "sensor_msgs/msg/magnetic_field.hpp"
#include "sensor_msgs/msg/image.hpp"
#include "std_msgs/msg/string.hpp"

using namespace std::chrono_literals;

class ControlCenter final : public rclcpp::Node
{
public:
  ControlCenter()
  : Node("control_center")
  {
    // Hardware and simulation drivers are normalized before this node. High-
    // level control therefore only consumes the canonical vehicle interface.
    declare_parameter("image_topic", "/camera/image_raw");
    declare_parameter("scan_topic", "/scan");
    declare_parameter("imu_topic", "/imu/data");
    declare_parameter("mag_topic", "/imu/mag");
    declare_parameter("odom_topic", "/odometry/filtered");

    const auto sensor_qos = rclcpp::SensorDataQoS();

    image_sub_ = create_subscription<sensor_msgs::msg::Image>(
      get_parameter("image_topic").as_string(), sensor_qos,
      [this](sensor_msgs::msg::Image::ConstSharedPtr message) {
        image_received_ = true;
        image_width_ = message->width;
        image_height_ = message->height;
        image_encoding_ = message->encoding;
        image_stamp_ = this->now();
      });

    scan_sub_ = create_subscription<sensor_msgs::msg::LaserScan>(
      get_parameter("scan_topic").as_string(), sensor_qos,
      [this](sensor_msgs::msg::LaserScan::ConstSharedPtr message) {
        scan_received_ = true;
        scan_stamp_ = this->now();
        // Fixed directions in the LiDAR frame: positive angles point left.
        lidar_front_ = distance_at_angle(*message, 0.0);
        lidar_left_25_ = distance_at_angle(*message, 25.0);
        lidar_left_45_ = distance_at_angle(*message, 45.0);
        lidar_right_25_ = distance_at_angle(*message, -25.0);
        lidar_right_45_ = distance_at_angle(*message, -45.0);
        front_distance_ = lidar_front_;
      });

    imu_sub_ = create_subscription<sensor_msgs::msg::Imu>(
      get_parameter("imu_topic").as_string(), sensor_qos,
      [this](sensor_msgs::msg::Imu::ConstSharedPtr message) {
        imu_received_ = true;
        imu_stamp_ = this->now();
        acceleration_norm_ = std::sqrt(
          message->linear_acceleration.x * message->linear_acceleration.x +
          message->linear_acceleration.y * message->linear_acceleration.y +
          message->linear_acceleration.z * message->linear_acceleration.z);
        angular_speed_ = std::sqrt(
          message->angular_velocity.x * message->angular_velocity.x +
          message->angular_velocity.y * message->angular_velocity.y +
          message->angular_velocity.z * message->angular_velocity.z);
      });

    mag_sub_ = create_subscription<sensor_msgs::msg::MagneticField>(
      get_parameter("mag_topic").as_string(), sensor_qos,
      [this](sensor_msgs::msg::MagneticField::ConstSharedPtr message) {
        mag_received_ = true;
        mag_stamp_ = this->now();
        magnetic_field_norm_ = std::sqrt(
          message->magnetic_field.x * message->magnetic_field.x +
          message->magnetic_field.y * message->magnetic_field.y +
          message->magnetic_field.z * message->magnetic_field.z);
      });

    odom_sub_ = create_subscription<nav_msgs::msg::Odometry>(
      get_parameter("odom_topic").as_string(), 10,
      [this](nav_msgs::msg::Odometry::ConstSharedPtr message) {
        odom_received_ = true;
        odom_stamp_ = this->now();
        speed_ = std::hypot(
          message->twist.twist.linear.x, message->twist.twist.linear.y);
      });

    status_pub_ = create_publisher<std_msgs::msg::String>(
      "/control_center/status", 10);
    drive_publisher_ = create_publisher<rc_car_interfaces::msg::DriveRequest>(
      "/control/autonomous_cmd", 10);
    status_timer_ = create_wall_timer(100ms, [this]() {
      publish_status();
      autonomous_drive();
    });

    RCLCPP_INFO(
      get_logger(),
      "Control Center aktiv: Kamera=%s LiDAR=%s IMU=%s Magnetometer=%s Odom=%s",
      get_parameter("image_topic").as_string().c_str(),
      get_parameter("scan_topic").as_string().c_str(),
      get_parameter("imu_topic").as_string().c_str(),
      get_parameter("mag_topic").as_string().c_str(),
      get_parameter("odom_topic").as_string().c_str());
  }

private:
  double distance_at_angle(
    const sensor_msgs::msg::LaserScan & scan, double angle_degrees) const
  {
    const double angle_rad = angle_degrees * M_PI / 180.0;
    if (scan.angle_increment == 0.0 || scan.ranges.empty()) {
      return std::numeric_limits<double>::infinity();
    }

    const auto index = static_cast<long>(std::lround(
      (angle_rad - scan.angle_min) / scan.angle_increment));
    if (index < 0 || index >= static_cast<long>(scan.ranges.size())) {
      return std::numeric_limits<double>::infinity();
    }

    const double distance = scan.ranges[static_cast<std::size_t>(index)];
    if (!std::isfinite(distance) ||
      distance < scan.range_min || distance > scan.range_max)
    {
      return std::numeric_limits<double>::infinity();
    }
    return distance;
  }

  double nearest_front_distance(const sensor_msgs::msg::LaserScan & scan) const
  {
    constexpr double front_half_angle = 30.0 * M_PI / 180.0;
    double nearest = std::numeric_limits<double>::infinity();
    for (std::size_t index = 0; index < scan.ranges.size(); ++index) {
      const double angle = scan.angle_min + index * scan.angle_increment;
      if (std::abs(angle) > front_half_angle) {
        continue;
      }
      const double range = scan.ranges[index];
      if (std::isfinite(range) && range >= scan.range_min && range <= scan.range_max) {
        nearest = std::min(nearest, range);
      }
    }
    return nearest;
  }

  double age_seconds(const rclcpp::Time & stamp, bool received) const
  {
    if (!received) {
      return -1.0;
    }
    return std::max(0.0, (now() - stamp).seconds());
  }

  void publish_drive_request(int steering, int speed)
  {
    rc_car_interfaces::msg::DriveRequest command;
    command.steering = static_cast<int8_t>(std::clamp(steering, -100, 100));
    command.speed = static_cast<int8_t>(std::clamp(speed, -100, 100));
    requested_steering_ = command.steering;
    requested_speed_ = command.speed;
    drive_publisher_->publish(command);
  }

  void autonomous_drive()
  {
    auto valid_distance = [](double distance) {
      return std::isfinite(distance) ? distance : 25.0;
    };

    const double distance_left =
      valid_distance(lidar_front_) +
      valid_distance(lidar_left_25_) +
      valid_distance(lidar_left_45_);
    const double distance_right =
      valid_distance(lidar_front_) +
      valid_distance(lidar_right_25_) +
      valid_distance(lidar_right_45_);

    if (!scan_received_ || age_seconds(scan_stamp_, true) > 0.5) {
      publish_drive_request(0, 0);
      return;
    }

    constexpr int forward = 100;
    if (distance_left < distance_right) {
      // Less space on the left: steer right.
      publish_drive_request(50, forward);
    } else if (distance_right < distance_left) {
      // Less space on the right: steer left.
      publish_drive_request(-50, forward);
    } else {
      publish_drive_request(0, forward);
    }
  }

  void publish_status()
  {
    std::ostringstream output;
    output << std::fixed << std::setprecision(3)
           << "{\"camera\":{\"received\":" << (image_received_ ? "true" : "false")
           << ",\"age_s\":" << age_seconds(image_stamp_, image_received_)
           << ",\"width\":" << image_width_ << ",\"height\":" << image_height_
           << ",\"encoding\":\"" << image_encoding_ << "\"},"
           << "\"lidar\":{\"received\":" << (scan_received_ ? "true" : "false")
           << ",\"age_s\":" << age_seconds(scan_stamp_, scan_received_)
           << ",\"front_distance_m\":" << front_distance_
           << ",\"left_25_distance_m\":" << lidar_left_25_
           << ",\"left_45_distance_m\":" << lidar_left_45_
           << ",\"right_25_distance_m\":" << lidar_right_25_
           << ",\"right_45_distance_m\":" << lidar_right_45_ << "},"
           << "\"imu\":{\"received\":" << (imu_received_ ? "true" : "false")
           << ",\"age_s\":" << age_seconds(imu_stamp_, imu_received_)
           << ",\"acceleration_mps2\":" << acceleration_norm_
           << ",\"angular_speed_radps\":" << angular_speed_ << "},"
           << "\"magnetometer\":{\"received\":" << (mag_received_ ? "true" : "false")
           << ",\"age_s\":" << age_seconds(mag_stamp_, mag_received_)
           << ",\"field_t\":" << magnetic_field_norm_ << "},"
           << "\"odometry\":{\"received\":" << (odom_received_ ? "true" : "false")
           << ",\"age_s\":" << age_seconds(odom_stamp_, odom_received_)
           << ",\"speed_mps\":" << speed_ << "},"
           << "\"autonomous_request\":{\"steering\":"
           << static_cast<int>(requested_steering_)
           << ",\"speed\":" << static_cast<int>(requested_speed_) << "}}";

    std_msgs::msg::String status;
    status.data = output.str();
    status_pub_->publish(status);

  }

  rclcpp::Subscription<sensor_msgs::msg::Image>::SharedPtr image_sub_;
  rclcpp::Subscription<sensor_msgs::msg::LaserScan>::SharedPtr scan_sub_;
  rclcpp::Subscription<sensor_msgs::msg::Imu>::SharedPtr imu_sub_;
  rclcpp::Subscription<sensor_msgs::msg::MagneticField>::SharedPtr mag_sub_;
  rclcpp::Subscription<nav_msgs::msg::Odometry>::SharedPtr odom_sub_;
  rclcpp::Publisher<std_msgs::msg::String>::SharedPtr status_pub_;
  rclcpp::Publisher<rc_car_interfaces::msg::DriveRequest>::SharedPtr drive_publisher_;
  rclcpp::TimerBase::SharedPtr status_timer_;

  bool image_received_{false};
  bool scan_received_{false};
  bool imu_received_{false};
  bool mag_received_{false};
  bool odom_received_{false};
  uint32_t image_width_{0};
  uint32_t image_height_{0};
  std::string image_encoding_{""};
  double front_distance_{std::numeric_limits<double>::infinity()};
  double lidar_front_{std::numeric_limits<double>::infinity()};
  double lidar_left_25_{std::numeric_limits<double>::infinity()};
  double lidar_left_45_{std::numeric_limits<double>::infinity()};
  double lidar_right_25_{std::numeric_limits<double>::infinity()};
  double lidar_right_45_{std::numeric_limits<double>::infinity()};
  double acceleration_norm_{0.0};
  double angular_speed_{0.0};
  double magnetic_field_norm_{0.0};
  double speed_{0.0};
  int8_t requested_steering_{0};
  int8_t requested_speed_{0};
  rclcpp::Time image_stamp_;
  rclcpp::Time scan_stamp_;
  rclcpp::Time imu_stamp_;
  rclcpp::Time mag_stamp_;
  rclcpp::Time odom_stamp_;
};

int main(int argc, char * argv[])
{
  rclcpp::init(argc, argv);
  rclcpp::spin(std::make_shared<ControlCenter>());
  rclcpp::shutdown();
  return 0;
}
