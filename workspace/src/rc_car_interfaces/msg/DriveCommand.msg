# Normalized command generated by a driving controller.
#
# speed:    -100 = full reverse, 0 = stopped, +100 = full forward
# steering: -100 = full left,    0 = straight, +100 = full right
# enabled=false always requests a safe, de-energized stop.

std_msgs/Header header
uint32 sequence
int8 speed
int8 steering
bool enabled
